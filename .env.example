# =============================================================================
# FindWorker Environment Configuration
# Copy this file to .env for local development
# =============================================================================

APP_NAME="FindWorker"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT="development"

# Cryptographic JWT Secret Key (required in production, min 32 characters)
SECRET_KEY="generate-a-strong-secret-key-for-local-testing"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Aurora)
# Leave DB_PASSWORD empty to fallback to local SQLite for instant testing
DB_NAME="findworker"
DB_USER="postgres"
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT=5432

# Or provide explicit full database connection string:
# DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/findworker"

# Redis Cache & Sessions URL
REDIS_URL="redis://localhost:6379/0"

